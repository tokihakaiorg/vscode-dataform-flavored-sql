{
  "name": "dataform-flavored-sql",
  "displayName": "Dataform flavored SQL",
  "description": "VS Code extension that provides Dataform flavored SQL definition with syntax highlighting in JS and TS tagged template",
  "publisher": "tokihakaiorg",
  "version": "0.0.0-beta.0",
  "repository": {
    "url": "https://github.com/tokihakaiorg/vscode-dataform-flavored-sql.git"
  },
  "bugs": {
    "url": "https://github.com/tokihakaiorg/vscode-dataform-flavored-sql/issues"
  },
  "engines": {
    "vscode": "^1.20.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets",
    "Data Science",
    "Testing"
  ],
  "keywords": [
    "dataform",
    "bigquery",
    "sqlx",
    "javascript",
    "typescript",
    "tagged",
    "template",
    "embedded"
  ],
  "contributes": {
    "languages": [
      {
        "id": "df-sql",
        "aliases": [
          "Dataform-flavored SQL"
        ],
        "configuration": "syntaxes/df-sql.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "df-sql",
        "scopeName": "source.df-sql",
        "path": "./syntaxes/df-sql.tmLanguage.json"
      },
      {
        "injectTo": [
          "source.js",
          "source.cjs",
          "source.mjs",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "text.html.markdown",
          "source.sqlx"
        ],
        "scopeName": "inline.template-tagged-languages",
        "path": "./syntaxes/grammar.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json",
          "meta.embedded.block.df_sql": "df-sql"
        }
      },
      {
        "injectTo": [
          "source.js",
          "source.cjs",
          "source.mjs",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "text.html.markdown",
          "source.sqlx"
        ],
        "scopeName": "inline.template-tagged-languages.reinjection",
        "path": "./syntaxes/reinject-grammar.json",
        "embeddedLanguages": {
          "meta.template.expression.ts": "typescript"
        }
      }
    ]
  },
  "devDependencies": {},
  "scripts": {
    "build": "node ./build/build",
    "getEmbedded": "node ./build/getEmbedded",
    "vsce:package": "npx -y vsce@2.15.0 package && mkdir -p dist && mv dataform-flavored-sql-*.vsix dist/",
    "vsce:login": "npx -y vsce@2.15.0 login tokihakaiorg",
    "vsce:publish": "npx -y vsce@2.15.0 publish",
    "_end": ""
  }
}